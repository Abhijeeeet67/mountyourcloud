# ==============================================================================
# MOUNTYOURCLOUDS — PRODUCTION ENVIRONMENT VARIABLES (.env.example)
# Tagline: Every cloud. One place.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND PUBLIC VARIABLES (Safe for Browser Bundle — VITE_* prefix)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_API_BASE_URL=
VITE_LEGAL_BUSINESS_NAME=MountYourClouds Software
VITE_SUPPORT_EMAIL=support@mountyourclouds.com
VITE_PRIVACY_EMAIL=privacy@mountyourclouds.com
VITE_REGISTERED_COUNTRY=India

# ------------------------------------------------------------------------------
# 2. BACKEND CORE & CRYPTOGRAPHIC SECRETS (Server-Only — NEVER expose via VITE_*)
# ------------------------------------------------------------------------------
APP_URL=https://ais-pre-pqidunhrnlbzaqxaqgzotq-984872346664.asia-east1.run.app
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Owner Administrator User ID (Supabase Auth UUID of the platform owner)
MOUNTYOURCLOUDS_ADMIN_USER_ID=

# AES-256-GCM Master Encryption Keys (Generate with: openssl rand -hex 32)
APP_SECRETS_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY=
OAUTH_ENCRYPTION_KEY=
OAUTH_ENCRYPTION_KEY_PREVIOUS=
SESSION_SECRET=

# ------------------------------------------------------------------------------
# 3. CLOUD PROVIDER OAUTH 2.0 CREDENTIALS (Server-Only)
# Authorized Redirect URI: ${APP_URL}/api/oauth/callback
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=

DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=

BOX_CLIENT_ID=
BOX_CLIENT_SECRET=

PCLOUD_CLIENT_ID=
PCLOUD_CLIENT_SECRET=

# Optional Default S3 / R2 Server Credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_S3_BUCKET=

# ------------------------------------------------------------------------------
# 4. RAZORPAY PAYMENT GATEWAY (Can also be configured in /app/admin UI)
# Webhook Endpoint: ${APP_URL}/api/billing/webhook
# ------------------------------------------------------------------------------
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_PRO_MONTHLY=
RAZORPAY_PLAN_PRO_ANNUAL=
RAZORPAY_PLAN_ULTRA_MONTHLY=
RAZORPAY_PLAN_ULTRA_ANNUAL=